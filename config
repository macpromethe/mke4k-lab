# ============================================================
#  mke4k-lab -- cluster configuration
#  Edit this file, then run:  t deploy lab
#
#  1. Basic setup       -- what you usually change
#  2. Airgap settings   -- only for airgapped deployments
#  3. Advanced settings -- fine-tuning; defaults are sensible
# ============================================================

# ============================================================
#  1. Basic setup
# ============================================================

# Name prefix for all AWS resources. Leave as "mke4k-lab" and the first deploy
# asks for your name (-> mke4k-lab-<name>, also tagged as Owner).
cluster_name="mke4k-lab"

# AWS region to deploy into.
region="eu-central-1"

# Auto-delete the lab this many days after creation (0 = never).
# Change it later with 't expiry <days>'.
expiry_days=3

# Node counts. Controllers: 1, or 3 for HA (must be odd).
controller_count=1
worker_count=1

# Node OS: ubuntu (22.04, 24.04) | redhat (9.6, 8.10).
os_name="ubuntu"
os_version="22.04"

# AWS Cloud Controller Manager: needed for LoadBalancer services and EBS volumes.
# Always off in airgap.
ccm_enabled=false

# -- MKE4k --
# Releases: https://github.com/MirantisContainers/mke-release/releases
mke4k_version="v4.2.0"

# k0rdent UI. false -> deploy it later with 't deploy k0rdent-ui'.
k0rdent_ui_enabled=false

# -- MKE4k child cluster (t deploy child-cluster) --
# Not part of 't deploy lab': a separate step, run after the cluster is up.
# Online MKE4k only.
child_control_plane_count=1
child_worker_count=1

# -- MSR4 (t deploy msr4) --
msr4_enabled=false
msr4_version="4.13.3"
# 1 = simple (built-in DB + Redis) | 2+ = HA (needs nfs_enabled=true)
msr4_replicas=1

# -- KOF observability (t deploy kof) --
# Requires MKE 4.2.0+. true -> deploys automatically at the end of 't deploy lab'.
kof_enabled=false
# Must match the cluster's k0rdent release. Validated: 1.8.1 (MKE 4.2.0), 1.4.1 (MKE 4.2.1).
kof_version="1.8.1"
# lean = cluster monitoring only | full = complete observability + FinOps
kof_mode="lean"

# -- MKE3 (t deploy lab mke3) --
mke3_version="3.8.2"
mcr_version="25.0.14"
# Must match mcr_version exactly: stable-<mcr_version>
mcr_channel="stable-25.0.14"

# -- NFS storage --
# NFS server + 'nfs-client' default StorageClass (required by KOF and MSR4 HA).
nfs_enabled=true

# ============================================================
#  2. Airgap settings   (only for 't deploy lab airgap' / 'mke3-airgap')
# ============================================================

# Bastion/registry host (runs the MSR4 registry + image uploads).
airgap_registry_flavor="t3.xlarge"
airgap_registry_disk_gb=100

# MSR4 offline installer version for the bastion registry.
# Releases: https://s3-us-east-2.amazonaws.com/packages-mirantis.com/msr/
airgap_msr_version="v4.13.3"

# Bundle download URL overrides (GA versions only; RC/dev builds are online-only).
# mke4k_bundle_url=""
# mke3_bundle_url=""

# ============================================================
#  3. Advanced settings   (defaults are sensible; change only if needed)
# ============================================================

# -- Instances --
# Controllers: at least 4 vCPU / 16 GB.
controller_flavor="m5a.xlarge"
worker_flavor="m5a.large"

# Verbose mkectl output (-l debug).
debug=true

# true -> the expiry reaper only logs what it would delete.
expiry_dry_run=false

# -- k0rdent UI gateway --
# Envoy NodePort (range 32768-35535) and NLB listener port.
k0rdent_ui_nodeport=33003
k0rdent_ui_lb_port=8445

# -- MKE4k child cluster --
# Dex 'admin' login for the child UI -> terraform/child_credentials.txt.
child_admin_enabled=true
# SSH via a bastion locked to your public IP ('t connect m1-child').
# Set before creating the child: the SSH key can't be added later.
child_ssh_enabled=true
# Bastion SSH source (empty = your public IP/32).
child_ssh_allowed_cidr=""
# Child region (empty = same as 'region'; SSH needs the same region).
child_region=""
# Instance types (empty = template defaults: m5.xlarge / m5.large).
child_control_plane_flavor=""
child_worker_flavor=""
child_az_limit=1
child_ready_timeout="30m"
child_delete_timeout="30m"

# -- MKE3 --
launchpad_version="1.5.15"
# MKE3 UI admin (password -> terraform/mke3_credentials.txt).
mke3_admin_username="admin"

# -- NFS server --
nfs_flavor="t3.small"
nfs_disk_gb=150
nfs_export_path="/srv/nfs/data"

# -- MSR4 HA (msr4_replicas >= 2) --
msr4_postgres_version="1.15.1"
msr4_redis_operator_version="0.24.0"
msr4_redis_replication_version="0.16.13"
msr4_storage_size="10Gi"

# -- KOF --
# PVC size for the VictoriaMetrics / Logs / Traces volumes.
kof_storage_size="10Gi"
# Image/chart registry (auto-derived in airgap).
kof_registry="registry.mirantis.com/k0rdent-enterprise"
# Grafana, exposed over HTTPS on the NLB (airgap: 't tunnel grafana').
kof_grafana_enabled=true
kof_grafana_image_tag="11.0.0"
kof_grafana_gateway_enabled=true
kof_grafana_nodeport=33002
kof_grafana_lb_port=8443
# Reuse MKE's built-in monitoring instead of duplicating it.
kof_reuse_mke_monitoring=true
# Also drop KOF's duplicate kubelet scrape (avoids 2x pod CPU/memory).
kof_reuse_mke_kubelet=true
# Route alerts to sf-notifier (deploy sf-notifier separately first).
kof_sf_notifier_enabled=false
# Namespace where k0rdent runs.
kof_kcm_namespace="k0rdent"
# HA topology for VictoriaMetrics / VictoriaLogs.
kof_storage_ha=true
# Lean-mode Grafana prune lists (comma-separated).
kof_lean_prune_folders="Istio,Opencost,Victoria Traces"
kof_lean_prune_dashboards="kps-nodes-aix,kps-nodes-darwin"
